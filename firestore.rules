rules_version = '2';

// Règles de sécurité Firestore de CosmaPlus.
// Déployer : firebase deploy --only firestore:rules --project projetmobile-4csde2
// (ou copier-coller dans Console Firebase > Firestore > Règles > Publier)
//
// Chaque module est responsable du bloc de sa collection (voir docs/EQUIPE.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Fonctions communes (module Utilisateurs) ─────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Connecté, avec un profil, et pas désactivé.
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().data.get('disabled', false) == false;
    }

    function isAdmin() {
      return isActive() && myProfile().data.role == 'admin';
    }

    // Photo de profil : absente, ou hébergée sur Cloudinary uniquement.
    function validPhoto() {
      let photo = request.resource.data.get('photoUrl', null);
      return photo == null
        || (photo is string && photo.matches('^https://res[.]cloudinary[.]com/.*'));
    }

    // Seuls ces champs changent dans la mise à jour.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Note d'avis valide : entier de 1 à 5.
    function validRating() {
      return request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    // ─── users (module Utilisateurs) ──────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Inscription : uniquement son propre profil, en tant que client actif.
      // Un admin peut créer n'importe quel profil (client ou admin).
      allow create: if validPhoto() && (isAdmin()
        || (isSelf(uid)
            && request.resource.data.role == 'client'
            && request.resource.data.get('disabled', false) == false));

      // Un utilisateur modifie son profil (nom, photo…), sauf son rôle et son statut.
      allow update: if validPhoto() && (isAdmin()
        || (isSelf(uid) && isActive()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'disabled', 'createdAt'])));

      allow delete: if isSelf(uid) || isAdmin();
    }

    // ─── products (module Produits, + note des avis) ──────────────────────
    // Le stock est modifié par l'admin (confirmation / annulation de commande).
    match /products/{id} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // Avis : mise à jour de la note moyenne uniquement.
        || (isActive() && onlyChanges(['ratingAverage', 'ratingCount']));
    }

    // ─── reviews (module Avis) ────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;

      // Un client actif publie un avis en son propre nom.
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && validRating();

      // L'auteur modifie son avis, sans changer d'auteur ni de produit.
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId
        && validRating();

      // L'auteur ou un admin supprime l'avis.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── orders (module Commandes) ────────────────────────────────────────
    match /orders/{orderId} {
      // Le client lit ses commandes ; l'admin lit tout.
      allow read: if isAdmin()
        || (isActive() && resource.data.userId == request.auth.uid);

      // Le client crée une commande à son nom, en attente, stock non retiré.
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'enAttente'
        && request.resource.data.stockReserved == false
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0;

      // L'admin fait avancer le statut.
      // Le client peut seulement annuler sa commande tant qu'elle est en attente.
      allow update: if isAdmin()
        || (isActive()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'enAttente'
            && request.resource.data.status == 'annulee'
            && onlyChanges(['status', 'updatedAt', 'history']));

      // Une commande n'est jamais supprimée (historique de la boutique).
      allow delete: if false;
    }

    // ─── carts (module Panier) ────────────────────────────────────────────
    // carts/{uid} : résumé du panier ; carts/{uid}/items/{productId} : articles.
    match /carts/{uid} {
      allow read: if (isSelf(uid) && isActive()) || isAdmin();
      allow create, update: if isSelf(uid) && isActive()
        && request.resource.data.userId == uid;
      allow delete: if (isSelf(uid) && isActive()) || isAdmin();

      match /items/{productId} {
        allow read: if (isSelf(uid) && isActive()) || isAdmin();
        // Quantité entière entre 1 et 99.
        allow create, update: if isSelf(uid) && isActive()
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 99;
        allow delete: if (isSelf(uid) && isActive()) || isAdmin();
      }
    }

    // ─── Autres modules : règles PROVISOIRES ──────────────────────────────
    // TODO(chaque module) : remplacer par des règles précises.
    match /categories/{id} {
      allow read, write: if isActive();
    }
  }
}
